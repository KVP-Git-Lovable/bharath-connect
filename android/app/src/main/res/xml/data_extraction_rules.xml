<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml. See that file for the reason. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_usage_state.xml" />
        <exclude domain="file" path="app_usage" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_usage_state.xml" />
        <exclude domain="file" path="app_usage" />
    </device-transfer>
</data-extraction-rules>
