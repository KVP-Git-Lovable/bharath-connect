+    @PluginMethod()
+    public void beginNativeBufferDrain(PluginCall call) {
+        JSObject ret = new JSObject();
+        JSArray locations = new JSArray();
+        String token = GpsBufferJournal.beginDrain(getContext());
+        if (token != null) {
+            for (JSONObject record : GpsBufferJournal.read(getContext(), token)) {
+                locations.put(record);
+            }
+        }
