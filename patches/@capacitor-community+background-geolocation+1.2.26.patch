+            }
+        }
+
+        void stopService() {
+            // Bridge destruction is not checkout. onUnbind hands an open
+            // day to native buffering without removing started-service status.
+            if (!isDayOpen(BackgroundGeolocationService.this)) {
+                BackgroundGeolocationService.this.stopSelf();
+            }
+        }
+    }
