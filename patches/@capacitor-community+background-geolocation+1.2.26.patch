+    /**
+     * Drain the native observation buffer written by the service (real device
+     * fixes recorded independently of the JS bridge) and report the native
+     * health timestamps. Read-and-delete under the shared lock so a fix is
+     * handed to JS exactly once.
+     */
+    @PluginMethod()
+    public void drainNativeLocationBuffer(PluginCall call) {
+        JSObject ret = new JSObject();
+        JSArray locations = new JSArray();
+        synchronized (BackgroundGeolocationService.NATIVE_BUFFER_LOCK) {
+            java.io.File f = new java.io.File(
+                    getContext().getFilesDir(),
+                    BackgroundGeolocationService.NATIVE_BUFFER_FILE
+            );
+            if (f.exists()) {
+                try (java.io.BufferedReader reader =
+                             new java.io.BufferedReader(new java.io.FileReader(f))) {
+                    String line;
+                    while ((line = reader.readLine()) != null) {
+                        line = line.trim();
+                        if (line.isEmpty()) continue;
+                        try {
+                            locations.put(new org.json.JSONObject(line));
+                        } catch (Exception ignored) {
+                            // A torn/corrupt line (e.g. process death mid-write)
+                            // is skipped; it was never a complete observation.
+                        }
+                    }
+                } catch (Exception ignored) {
+                }
+                //noinspection ResultOfMethodCallIgnored
+                f.delete();
+            }
+        }
+        android.content.SharedPreferences prefs = getContext().getSharedPreferences(
+                BackgroundGeolocationService.NATIVE_HEALTH_PREFS,
+                Context.MODE_PRIVATE
+        );
+        ret.put("locations", locations);
+        ret.put("lastNativeCallbackAt", prefs.getLong("lastNativeCallbackAt", 0));
+        ret.put("serviceStartedAt", prefs.getLong("serviceStartedAt", 0));
+        call.resolve(ret);
+    }
