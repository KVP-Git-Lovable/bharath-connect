+                BackgroundGeolocationService.NATIVE_HEALTH_PREFS,
+                Context.MODE_PRIVATE
+        );
+        ret.put("token", token);
+        ret.put("locations", locations);
+        ret.put("lastNativeCallbackAt", prefs.getLong("lastNativeCallbackAt", 0));
+        ret.put("serviceStartedAt", prefs.getLong("serviceStartedAt", 0));
+        ret.put("lastRealGpsFixTimestamp", prefs.getLong("lastRealGpsFixTimestamp", 0));
+        ret.put("lastNativePersistenceTimestamp", prefs.getLong("lastNativePersistenceTimestamp", 0));
+        ret.put("lastServiceHeartbeatTimestamp", prefs.getLong("lastServiceHeartbeatTimestamp", 0));
