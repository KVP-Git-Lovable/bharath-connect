+package com.equimaps.capacitor_background_geolocation;
+
+import android.content.Context;
+import android.util.Log;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.FileReader;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+
+/**
+ * Durable storage for native GPS fixes, independent of the JS bridge.
+ *
+ * Mirrors ai.quickapp.fieldforce.AppUsageJournal's proven shape (append-only
+ * JSONL in getFilesDir() plus a two-phase stage/read/ack drain) — that class
+ * can't be reused directly since this plugin builds as its own Gradle module,
+ * separate from the app module it lives in, but the mechanics are copied
+ * deliberately rather than reinvented.
+ *
+ * One difference from the plugin's previous read-and-delete buffer, and it is
+ * intentional: a drain the JS side starts but never finishes (app killed
+ * mid-sync) must replay, not disappear. beginDrain() moves the journal aside
+ * under a token; ack() deletes it only once the caller confirms the records
+ * are safely queued elsewhere. A journal left inflight by a crashed drain is
+ * folded into the next one automatically.
+ */
+final class GpsBufferJournal {
+
+    private static final String TAG = "GpsBufferJournal";
+
+    /** Guards every read/append/rename of the journal files. */
+    static final Object LOCK = new Object();
+
+    /** Own subdirectory so this can be excluded from backups by folder. */
+    private static final String DIR = "gps_buffer";
+    static final String JOURNAL_FILE = "gps_native_buffer.jsonl";
+    private static final String INFLIGHT_PREFIX = "gps_native_buffer.inflight.";
+    private static final String INFLIGHT_SUFFIX = ".jsonl";
+
+    private GpsBufferJournal() {}
+
+    private static File dir(Context ctx) {
+        File d = new File(ctx.getFilesDir(), DIR);
+        if (!d.exists() && !d.mkdirs()) Log.w(TAG, "could not create " + DIR);
+        return d;
+    }
+
+    private static File journal(Context ctx) {
+        return new File(dir(ctx), JOURNAL_FILE);
+    }
+
+    private static File inflight(Context ctx, String token) {
+        return new File(dir(ctx), INFLIGHT_PREFIX + token + INFLIGHT_SUFFIX);
+    }
+
+    /**
+     * Append one real fix. Called directly from the service's location
+     * callbacks, so a failure here must never throw back into them — the
+     * caller already runs this under a try/catch. Do not silently discard
+     * captured fixes just because the WebView has not drained yet.
+     */
+    static void append(Context ctx, JSONObject record) {
+        synchronized (LOCK) {
+            File f = journal(ctx);
+            try (FileOutputStream out = new FileOutputStream(f, true)) {
+                out.write((record.toString() + "\n").getBytes(StandardCharsets.UTF_8));
+                out.flush();
+                out.getFD().sync();
+            } catch (IOException e) {
+                Log.w(TAG, "journal append failed", e);
+            }
+        }
+    }
+
+    /**
+     * Phase one of a drain: adopt any journal left inflight by a previous
+     * drain that was never acked, fold the current journal into it, and hand
+     * back the token ack() will need.
+     *
+     * @return the token, or null when there is nothing to drain.
+     */
+    static String beginDrain(Context ctx) {
+        synchronized (LOCK) {
+            File existing = findInflight(ctx);
+            File live = journal(ctx);
+
+            if (existing != null) {
+                if (live.exists()) {
+                    appendFileTo(live, existing);
+                    live.delete();
+                }
+                return tokenOf(existing);
+            }
+
+            if (!live.exists() || live.length() == 0) return null;
+
+            String token = UUID.randomUUID().toString();
+            File target = inflight(ctx, token);
+            if (!live.renameTo(target)) {
+                Log.w(TAG, "could not move journal aside for drain");
+                return null;
+            }
+            return token;
+        }
+    }
+
+    /** Phase two: the records are safely queued on the JS side. */
+    static void ack(Context ctx, String token) {
+        synchronized (LOCK) {
+            File f = inflight(ctx, token);
+            if (f.exists() && !f.delete()) {
+                Log.w(TAG, "could not delete inflight journal " + token);
+            }
+        }
+    }
+
+    /** Parse the records held under a drain token. Malformed lines are skipped. */
+    static List<JSONObject> read(Context ctx, String token) {
+        List<JSONObject> out = new ArrayList<>();
+        synchronized (LOCK) {
+            File f = inflight(ctx, token);
+            if (!f.exists()) return out;
+            try (BufferedReader r = new BufferedReader(new FileReader(f))) {
+                String line;
+                while ((line = r.readLine()) != null) {
+                    line = line.trim();
+                    if (line.isEmpty()) continue;
+                    try {
+                        out.add(new JSONObject(line));
+                    } catch (JSONException e) {
+                        // A torn last line from a kill mid-write. Skip it.
+                        Log.w(TAG, "skipping malformed journal line");
+                    }
+                }
+            } catch (IOException e) {
+                Log.w(TAG, "journal read failed", e);
+            }
+        }
+        return out;
+    }
+
+    private static File findInflight(Context ctx) {
+        File[] files = dir(ctx).listFiles();
+        if (files == null) return null;
+        File oldest = null;
+        for (File f : files) {
+            String n = f.getName();
+            if (n.startsWith(INFLIGHT_PREFIX) && n.endsWith(INFLIGHT_SUFFIX)) {
+                if (oldest == null || f.lastModified() < oldest.lastModified()) oldest = f;
+            }
+        }
+        return oldest;
+    }
+
+    private static String tokenOf(File inflightFile) {
+        String n = inflightFile.getName();
+        return n.substring(INFLIGHT_PREFIX.length(), n.length() - INFLIGHT_SUFFIX.length());
+    }
+
+    private static void appendFileTo(File src, File dst) {
+        try (FileOutputStream out = new FileOutputStream(dst, true);
+             BufferedReader r = new BufferedReader(new FileReader(src))) {
+            String line;
+            while ((line = r.readLine()) != null) {
+                if (line.isEmpty()) continue;
+                out.write((line + "\n").getBytes(StandardCharsets.UTF_8));
+            }
+            out.flush();
+            out.getFD().sync();
+        } catch (IOException e) {
+            Log.w(TAG, "could not fold journal into inflight", e);
+        }
+    }
+}
