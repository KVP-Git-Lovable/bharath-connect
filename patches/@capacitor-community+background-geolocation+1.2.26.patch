+package com.equimaps.capacitor_background_geolocation;
+
+import android.Manifest;
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.app.Service;
+import android.content.SharedPreferences;
+import android.content.pm.PackageManager;
+import android.content.Intent;
+import android.content.pm.ServiceInfo;
+import android.location.Location;
+import android.os.Binder;
+import android.os.Build;
+import android.os.IBinder;
+
+import com.getcapacitor.Logger;
+import com.google.android.gms.location.FusedLocationProviderClient;
+import com.google.android.gms.location.LocationAvailability;
+import com.google.android.gms.location.LocationCallback;
+import com.google.android.gms.location.LocationRequest;
+import com.google.android.gms.location.LocationResult;
+import com.google.android.gms.location.LocationServices;
+
+import org.json.JSONObject;
+
+import java.util.HashSet;
+import java.util.UUID;
+
+import androidx.localbroadcastmanager.content.LocalBroadcastManager;
+
+// A bound and started service that is promoted to a foreground service
+// (showing a persistent notification) when the first background watcher is
+// added, and demoted when the last background watcher is removed.
+public class BackgroundGeolocationService extends Service {
+    static final String ACTION_BROADCAST = (
+            BackgroundGeolocationService.class.getPackage().getName() + ".broadcast"
+    );
+    private final IBinder binder = new LocalBinder();
+
+    // Must be unique for this application.
+    private static final int NOTIFICATION_ID = 28351;
+    public static final String ACTION_RECOVER = "jovo.gps.RECOVER";
+
+    // ---- Native observation buffer (JS-independence hardening) ----
+    // Every real fix is durably journaled (GpsBufferJournal) BEFORE the
+    // in-process broadcast to the WebView, so observations survive periods
+    // where the JS bridge is frozen, slow, or entirely dead. The JS layer
+    // drains the journal (beginNativeBufferDrain/ackNativeBufferDrain) into
+    // its existing capture pipeline; entries are real device fixes only —
+    // never synthesized.
+    public static final String NATIVE_HEALTH_PREFS = "gps_native_health";
+
+    private void recordNativeFix(Location location) {
+        try {
+            JSONObject record = new JSONObject();
+            record.put("id", UUID.randomUUID().toString());
+            record.put("latitude", location.getLatitude());
+            record.put("longitude", location.getLongitude());
+            record.put("accuracy", location.hasAccuracy() ? location.getAccuracy() : JSONObject.NULL);
+            record.put("speed", location.hasSpeed() ? location.getSpeed() : JSONObject.NULL);
+            record.put("bearing", location.hasBearing() ? location.getBearing() : JSONObject.NULL);
+            // Original OS fix time — distinct from when this process observed
+            // and persisted it, so a batched/delayed delivery is still visible
+            // as such rather than collapsed into "now".
+            record.put("time", location.getTime());
+            long persistedAt = System.currentTimeMillis();
+            record.put("recordedAt", persistedAt);
+            GpsBufferJournal.append(getApplicationContext(), record);
+
+            getApplicationContext()
+                    .getSharedPreferences(NATIVE_HEALTH_PREFS, MODE_PRIVATE)
+                    .edit()
+                    // Legacy key: staleness checks (TrackingRestarter.fixIsStale)
+                    // and the JS drain response already depend on this name.
+                    .putLong("lastNativeCallbackAt", persistedAt)
+                    // Distinct health signals (not duplicates): the OS fix time
+                    // itself, vs. the moment this process durably wrote it.
+                    .putLong("lastRealGpsFixTimestamp", location.getTime())
+                    .putLong("lastNativePersistenceTimestamp", persistedAt)
+                    .apply();
+        } catch (Exception ignored) {
+            // Buffering must never break acquisition.
+        }
+    }
+
+    private class Watcher {
+        public String id;
+        public FusedLocationProviderClient client;
+        public LocationRequest locationRequest;
+        public LocationCallback locationCallback;
+        public Notification backgroundNotification;
+    }
+    private HashSet<Watcher> watchers = new HashSet<Watcher>();
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return binder;
+    }
+
+    // ---- Restart / headless recording (reliability hardening) ----
+    // Set by the app (DeviceSettings.setTrackingDayOpen) at check-in and
+    // cleared at check-out. While a day is open the service is a *started*
+    // sticky service, so Android restarts it after a kill, and if no JS
+    // watcher is attached it records fixes straight into the native buffer
+    // (drained by the app on next open). Only real device fixes are written.
+    public static final String PREF_DAY_OPEN = "dayOpen";
+    public static final String PREF_DAY_OPENED_AT = "dayOpenedAt";
+    private static final long MAX_DAY_MS = 16L * 60 * 60 * 1000; // matches app auto-stop
+    private static final String HEADLESS_CHANNEL = "jovo_tracking_restart";
+    private FusedLocationProviderClient headlessClient;
+    private LocationCallback headlessCallback;
+
+    public static boolean isDayOpen(android.content.Context ctx) {
+        SharedPreferences p = ctx.getSharedPreferences(NATIVE_HEALTH_PREFS, MODE_PRIVATE);
+        if (!p.getBoolean(PREF_DAY_OPEN, false)) return false;
+        return System.currentTimeMillis() - p.getLong(PREF_DAY_OPENED_AT, 0) < MAX_DAY_MS;
+    }
+
+    private Notification headlessNotification() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            NotificationManager nm = (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
+            if (nm != null && nm.getNotificationChannel(HEADLESS_CHANNEL) == null) {
+                NotificationChannel ch = new NotificationChannel(
+                        HEADLESS_CHANNEL, "Day Tracking", NotificationManager.IMPORTANCE_LOW);
+                ch.setSound(null, null);
+                ch.enableVibration(false);
+                nm.createNotificationChannel(ch);
+            }
+        }
+        Notification.Builder b = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O
+                ? new Notification.Builder(this, HEADLESS_CHANNEL)
+                : new Notification.Builder(this);
+        b.setContentTitle("JOVO — Day Tracking active")
+                .setContentText("Tracking your workday location. Tap to open JOVO.")
+                .setOngoing(true);
+        int icon = getApplicationInfo().icon;
+        b.setSmallIcon(icon != 0 ? icon : android.R.drawable.ic_menu_mylocation);
+        Intent launch = getPackageManager().getLaunchIntentForPackage(getPackageName());
+        if (launch != null) {
+            int flags = Build.VERSION.SDK_INT >= Build.VERSION_CODES.M ? PendingIntent.FLAG_IMMUTABLE : 0;
+            b.setContentIntent(PendingIntent.getActivity(this, 0, launch, flags));
+        }
+        return b.build();
+    }
+
+    private boolean promoteForeground(Notification n) {
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+                startForeground(NOTIFICATION_ID, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_LOCATION);
+            } else {
+                startForeground(NOTIFICATION_ID, n);
+            }
+            getSharedPreferences(NATIVE_HEALTH_PREFS, MODE_PRIVATE).edit()
+                    .putLong("lastServiceHeartbeatTimestamp", System.currentTimeMillis())
+                    .remove("lastForegroundFailure").apply();
+            return true;
+        } catch (Exception e) {
+            Logger.error("Failed to foreground service (restart)", e);
+            getSharedPreferences(NATIVE_HEALTH_PREFS, MODE_PRIVATE).edit()
+                    .putString("lastForegroundFailure", e.getClass().getSimpleName() + ": " + e.getMessage()).apply();
+            return false;
+        }
+    }
+
+    private boolean hasLocationPermission() {
+        return checkSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED
+                || checkSelfPermission(Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED;
+    }
+
+    private void startHeadless() {
+        if (headlessCallback != null || !watchers.isEmpty() || !hasLocationPermission()) return;
+        headlessClient = LocationServices.getFusedLocationProviderClient(this);
+        LocationRequest req = new LocationRequest();
+        // Same cadence as the app's MOVING watcher config (3s/2s/8s, 5 m).
+        req.setInterval(3000);
+        req.setFastestInterval(2000);
+        req.setMaxWaitTime(8000);
+        req.setSmallestDisplacement(5f);
+        req.setPriority(LocationRequest.PRIORITY_HIGH_ACCURACY);
+        headlessCallback = new LocationCallback() {
+            @Override
+            public void onLocationResult(LocationResult result) {
+                for (Location l : result.getLocations()) recordNativeFix(l);
+            }
+        };
+        try {
+            headlessClient.requestLocationUpdates(req, headlessCallback, null);
+            getApplicationContext().getSharedPreferences(NATIVE_HEALTH_PREFS, MODE_PRIVATE)
+                    .edit().putLong("serviceStartedAt", System.currentTimeMillis()).apply();
+        } catch (SecurityException e) {
+            headlessCallback = null;
+        }
+    }
+
+    private void stopHeadless() {
+        if (headlessClient != null && headlessCallback != null) {
+            try { headlessClient.removeLocationUpdates(headlessCallback); } catch (Exception ignored) {}
+        }
+        headlessCallback = null;
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        // A startForegroundService() caller requires startForeground() within
+        // seconds, so always promote first (reusing the JS watcher's
+        // notification when one exists), then decide.
+        Notification existing = getNotification();
+        if (!promoteForeground(existing != null ? existing : headlessNotification())) {
+            stopSelf(startId);
+            return START_NOT_STICKY;
+        }
+        if (!isDayOpen(this) || !hasLocationPermission()) {
+            stopHeadless();
+            if (watchers.isEmpty()) {
+                stopForeground(true);
+                stopSelf(startId);
+            }
+            return START_NOT_STICKY;
+        }
+        if (watchers.isEmpty()) startHeadless();
+        else if (intent != null && ACTION_RECOVER.equals(intent.getAction())) {
+            long last = getSharedPreferences(NATIVE_HEALTH_PREFS, MODE_PRIVATE).getLong("lastNativeCallbackAt", 0);
+            if (System.currentTimeMillis() - last > 10L * 60 * 1000) {
